# Al-Mokhtar runs offline by default. Do not define these until its own
# dedicated Supabase project has been created and verified.
VITE_AL_MOKHTAR_SUPABASE_URL=
VITE_AL_MOKHTAR_SUPABASE_PUBLISHABLE_KEY=

# Server-only variables for privileged operations. Never expose the service key
# through a VITE_ variable.
AL_MOKHTAR_SUPABASE_URL=
AL_MOKHTAR_SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side AI feature only; never use a VITE_ prefix for this secret.
GEMINI_API_KEY=
